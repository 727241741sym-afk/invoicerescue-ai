# PayPal Sandbox credentials only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Must match the Business seller associated with the Sandbox app.
PAYPAL_MERCHANT_EMAIL=
# Configure after the HTTPS webhook endpoint is deployed
PAYPAL_WEBHOOK_ID=

# Vercel AI Gateway. Vercel deployments use request-scoped OIDC automatically.
# For local use, provide a Gateway key or pull a linked project's OIDC token.
AI_GATEWAY_API_KEY=
OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# Confirm availability in https://ai-gateway.vercel.sh/v1/models
OPENAI_MODEL=openai/gpt-4.1-mini
# Only used for other OpenAI-compatible endpoints, such as the local CLIProxyAPI.
# Set OPENAI_BASE_URL=http://127.0.0.1:8317/v1 and its own OPENAI_MODEL for that path.
OPENAI_API_KEY=

# Dedicated Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=

# Local development URL. Update for deployment.
APP_URL=http://127.0.0.1:3000
MERCHANT_TIMEZONE=Asia/Hong_Kong

# Optional merchant provisioning inputs. The setup script generates these locally
# when omitted, then stores them only in .env.local. Keep them server-side.
MERCHANT_LOGIN_EMAIL=
MERCHANT_LOGIN_PASSWORD=
MERCHANT_USER_ID=
